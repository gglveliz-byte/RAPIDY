# =============================================================================
# Rapidy — variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.
# Marcas: [OBLIGATORIA PROD] [RECOMENDADA PROD] [OPCIONAL] [SOLO DEV]
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
# No lo definas a mano en producción: la plataforma (Render/Vercel/Docker)
# inyecta NODE_ENV=production. En local Vite ya usa development.
# NODE_ENV=development

# Solo desarrollo local. En producción la plataforma inyecta PORT.
PORT=3000

# ── HTTP / CSRF / límites ────────────────────────────────────────────────────
# [OPCIONAL] Orígenes extra permitidos en mutaciones (coma-separados, con
# esquema). Solo si el front vive en otro dominio o hay transición de dominio.
APP_ORIGIN=
TRUSTED_ORIGINS=
# [OPCIONAL] Límite de body en bytes. Default 20 MB. Si lo cambias, ajusta el
# client_max_body_size del reverse proxy.
# MAX_BODY_BYTES=20971520

# ── Identidad de la app ──────────────────────────────────────────────────────
# [OBLIGATORIA PROD] Identificador lógico de la app; no es un secreto.
APP_ID=rapidy-app

# [OBLIGATORIA PROD] Secreto de firma de sesiones (cliente, negocio, reparto y
# admin). Mínimo 32 caracteres, aleatorio y distinto por entorno.
# Genera: openssl rand -hex 32
# Rotarlo invalida todas las sesiones activas.
APP_SECRET=

# ── Base de datos ────────────────────────────────────────────────────────────
# [OBLIGATORIA PROD] PostgreSQL. En producción usa SSL (sslmode=require) y un
# usuario con permisos mínimos sobre la base de Rapidy.
DATABASE_URL=postgresql://usuario:password@host:5432/rapidy?sslmode=require

# ── Administrador inicial ────────────────────────────────────────────────────
# [RECOMENDADA PROD] unionId del administrador propietario.
OWNER_UNION_ID=admin-prod

# [OBLIGATORIA PROD] Solo se usan en el arranque si el usuario admin todavía no
# existe. Cambiar estos valores NO cambia la contraseña de un admin ya creado.
ADMIN_EMAIL=admin@tudominio.com
# Mínimo 12 caracteres. Evita valores predecibles (admin, rapidy, password...).
ADMIN_PASSWORD=
ADMIN_NAME=Admin Rapidy

# ── OTP / WhatsApp (NeuroChat) ───────────────────────────────────────────────
# [OBLIGATORIA EN PROD PARA LOGIN POR TELÉFONO] Sin esta clave los OTP fallan.
# Genera la API Key con scope "otp" en:
# https://neurochat.com.ec/neuroapi/api-keys
NEUROCHAT_API_KEY=
# Opcional: phone_number_id o teléfono propio conectado. Si se omite, se usa el
# número predeterminado o la Línea Oficial compartida.
NEUROCHAT_OTP_FROM=
NEUROCHAT_BASE_URL=https://api.neurochat.com.ec/api/v1
# [OPCIONAL] Timeout por intento en ms, entero 2000-20000. Default 8000.
NEUROCHAT_TIMEOUT_MS=8000

# Entero entre 4 y 8.
OTP_LENGTH=6
# Entero entre 1 y 30 (minutos).
OTP_EXPIRY_MINUTES=5

# [SOLO DEV] Imprime el código en consola cuando no hay API Key. En producción
# debe quedar ausente o false: si vale true el arranque falla. En desarrollo,
# sin NEUROCHAT_API_KEY el fallback se activa automáticamente.
OTP_DEV_FALLBACK=false

# ── Push (Firebase Admin) — opcional ─────────────────────────────────────────
# JSON completo del service account en una sola línea. Es un secreto: no lo
# commitees. Si falta o es inválido, las notificaciones push se desactivan.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa local: ruta a un JSON fuera del repo. No commitear el archivo.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera-del-repo/firebase-adminsdk.json
# [OPCIONAL] Proyecto para Application Default Credentials.
# GCLOUD_PROJECT=
# GOOGLE_CLOUD_PROJECT=

# ── Observabilidad (logs) ────────────────────────────────────────────────────
# [OPCIONAL] debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info
LOG_SERVICE=rapidy-api
# [OPCIONAL] Se incluyen en cada log para correlacionar despliegues.
APP_VERSION=
GIT_SHA=

# ── Frontend (build-time, público) ──────────────────────────────────────────
# Las variables VITE_* se incrustan en el bundle del navegador: NUNCA secretos.
# [OPCIONAL] Default https://nominatim.openstreetmap.org
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# [OPCIONAL] Email de contacto exigido por la política de uso de Nominatim.
VITE_NOMINATIM_EMAIL=

# ── Solo desarrollo / pruebas E2E ────────────────────────────────────────────
# No configurar en producción.
E2E_BASE_URL=http://localhost:3000
E2E_OTP_CODE=
E2E_DRIVER_PHONE=0991234567
E2E_OTHER_DRIVER_PHONE=
E2E_DRIVER_PASSWORD=
# E2E_DRIVER_ORDER_ID=5
# E2E_DRIVER_CHAT_ORDER_ID=5
E2E_MERCHANT_EMAIL=comercio@test.com
E2E_MERCHANT_PASSWORD=
# Smoke de cliente: cliente existente, escrituras y evidencia.
# E2E_CUSTOMER_PHONE=+593 99 123 4567
# E2E_CUSTOMER_ALLOW_WRITES=1
# E2E_CUSTOMER_SCREENSHOTS=1
# E2E_PRODUCT_ID=
# E2E_DELIVERY_ADDRESS=Av. Amazonas y Naciones Unidas, Quito
# E2E_MAX_QTY=12
# E2E_HEADED=1
# E2E_IGNORE_HTTPS_ERRORS=1
# Host externo simulado en el smoke de autenticación.
# SMOKE_OUTSIDE_HOST=auth-smoke.localhost
# Escrituras y capturas en smoke de admin (solo staging/local autorizado).
# E2E_ADMIN_ALLOW_WRITES=1
# E2E_ADMIN_SCREENSHOTS=1
# Permitir smoke que escribe en una BD remota autorizada.
# E2E_ALLOW_REMOTE_DB=1
# Ruta al binario de Chromium/Chrome usado por los smoke tests.
# CHROME_PATH=C:\ruta\a\chrome.exe

# ── Operación / respaldos (solo scripts, nunca el servidor) ──────────────────
# Ver docs/production/BACKUP_DR.md. No commitear rutas con credenciales.
# BACKUP_DIR=C:\respaldos\rapidy
# BACKUP_FORMAT=custom
# Conexión directa sin pooler, solo para pg_dump.
# BACKUP_DATABASE_URL=postgresql://usuario:password@host:5432/rapidy
# PGPASSWORD=
# RESTORE_CHECK_ADMIN_URL=postgresql://admin:password@host:5432/postgres
# RESTORE_CHECK_TIMEOUT_MS=3600000
# HEALTH_BASE_URL=https://rapidy.example.com
# HEALTH_PATH=/api/health
# HEALTH_TIMEOUT_MS=10000
# HEALTH_MAX_LATENCY_MS=2000
# LOAD_TEST_BASE_URL=http://localhost:3000
# LOAD_TEST_COOKIE=