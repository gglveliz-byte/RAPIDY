# ── Backend ─────────────────────────────────────────────────────
APP_ID=rapidy-app
# Obligatorio en producción. Genera uno único, por ejemplo:
# openssl rand -hex 32
APP_SECRET=

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require

# ── Admin ───────────────────────────────────────────────────────
OWNER_UNION_ID=
# Define credenciales propias antes del primer arranque. No uses valores de ejemplo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin Rapidy
PORT=3000

# ── OTP / WhatsApp (NeuroChat) ─────────────────────────────────
# Genera tu API Key con scope "otp" en:
# https://neurochat.com.ec/neuroapi/api-keys
NEUROCHAT_API_KEY=
# Opcional: phone_number_id o teléfono propio conectado. Si se omite,
# se usa tu número predeterminado o la Línea Oficial compartida.
NEUROCHAT_OTP_FROM=
NEUROCHAT_BASE_URL=https://api.neurochat.com.ec/api/v1
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
# Solo para desarrollo local sin API Key: imprime el código en consola.
OTP_DEV_FALLBACK=true
